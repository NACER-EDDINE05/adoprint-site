# Laravel default .gitignore
/vendor
/node_modules
/storage/*.key
/.idea
/.vscode
/.env
/.env.*
!/.env.example
Homestead.json
Homestead.yaml
/.phpunit.result.cache
.phpunit.result.cache
.phpunit.coverage.cache

# NOTE: /public/storage is NOT ignored — on Vercel it holds the real uploaded
# images (product photos, settings). They must be committed so the demo shows them.


# OS files
Thumbs.db
.DS_Store

# npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
